PORT=5000
CONNECTION_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed frontend origins, or * for any
CLIENT_ORIGIN=http://localhost:5173
# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
# How often (seconds) live matches poll LeetCode for accepted submissions
POLL_INTERVAL_SEC=20
