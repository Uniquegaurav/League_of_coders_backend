PORT=5000
CONNECTION_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed frontend origins, or * for any
CLIENT_ORIGIN=http://localhost:5173
# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
# How often (seconds) live matches poll LeetCode for accepted submissions
POLL_INTERVAL_SEC=20
# Public frontend URL used in share links, link previews, emails and the sitemap
APP_URL=https://codersleague.mysummit.space
# Optional: emails (streak reminders, weekly recap, challenges). Free tier at resend.com.
RESEND_API_KEY=
EMAIL_FROM=League of Coders <noreply@your-verified-domain>
EMAIL_DAILY_CAP=90
STREAK_EMAIL_HOUR_UTC=14
# Daily battle hour and Sunday Cup start time (UTC, HH:MM). 15:30 UTC = 9 PM IST
BATTLE_HOUR_UTC=15:30
BATTLE_HOUR_ENABLED=true
# Encrypts Premium players' LeetCode sessions at rest. Set a long random value in production (defaults to JWT_SECRET).
PREMIUM_SECRET=
